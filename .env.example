# Configuración web exacta de tu aplicación Firebase.
# Se obtiene en Firebase Console > Configuración del proyecto > General > Tus apps > SDK.
VITE_FIREBASE_API_KEY=REEMPLAZAR_CON_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=servicios-vecinales.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=servicios-vecinales
VITE_FIREBASE_STORAGE_BUCKET=servicios-vecinales.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=REEMPLAZAR_CON_MESSAGING_SENDER_ID
VITE_FIREBASE_APP_ID=REEMPLAZAR_CON_APP_ID
VITE_FIREBASE_DATABASE_ID=(default)
