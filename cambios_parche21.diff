+  const handleShareProviderProfile = async () => {
+    if (!currentProvider) return;
+    setShareMessage('');
+    // Only share a deep link if a real public website URL has been configured.
+    // Capacitor's localhost origin is NOT a link that another person can open.
+    const configuredBase = import.meta.env.VITE_PUBLIC_APP_URL?.trim();
+    let profileUrl = '';
+    if (configuredBase) {
+      try {
+        const url = new URL(configuredBase);
+        if (url.protocol === 'https:' && url.hostname !== 'localhost' && url.hostname !== '127.0.0.1') {
+          url.searchParams.set('provider', currentProvider.id);
+          profileUrl = url.toString();
+        }
+      } catch { /* Invalid configuration: share text without a broken link. */ }
+    }
+    const message = [
+      'Te comparto mi perfil profesional en Servicios Vecinales:',
+      currentProvider.nombre_publico || currentUser?.nombre || currentProvider.oficio,
+      `Especialidad: ${currentProvider.oficio}`,
+      currentProvider.ubicacion ? `Ubicación: ${currentProvider.ubicacion}` : '',
+      profileUrl,
+    ].filter(Boolean).join('\n');
+    try {
+      if (navigator.share) {
+        await navigator.share({ title: 'Perfil profesional - Servicios Vecinales', text: message });
+        setShareMessage(profileUrl ? 'Perfil compartido.' : 'Información compartida. Falta configurar la dirección web pública para incluir un enlace al perfil.');
+      } else {
+        window.open(`https://wa.me/?text=${encodeURIComponent(message)}`, '_blank', 'noopener,noreferrer');
+        setShareMessage(profileUrl ? 'Se abrió WhatsApp para compartir el perfil.' : 'Se abrió WhatsApp con los datos del proveedor. Falta configurar la dirección web pública para incluir un enlace.');
+      }
+    } catch (error) {
+      if (error instanceof Error && error.name === 'AbortError') return;
+      setShareMessage('No se pudo abrir el menú para compartir. Inténtalo nuevamente.');
+    }
+  };
 
